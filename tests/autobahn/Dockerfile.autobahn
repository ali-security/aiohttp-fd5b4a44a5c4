FROM crossbario/autobahn-testsuite:25.10.1

RUN sed -i -e 's|deb.debian.org|archive.debian.org|g' -e '/bullseye-updates/d' /etc/apt/sources.list && apt-get update && apt-get install python3 python3-pip -y
RUN pip3 install wait-for-it==2.2.1

CMD ["wstest", "--mode", "fuzzingserver", "--spec", "/config/fuzzingserver.json"]
